/**
 * Users — the account list, read from the real API.
 *
 * Route: features/dashboard/pages/users.tsx  →  /dashboard/users
 *
 * Fetches GET /api/user/admin/users, which requires an admin role — the route
 * is guarded by `auth.requireUserRoles(['admin.tenant','admin.org','admin.system'])`.
 * A `user.basic` session gets 403, and that is correct: an ordinary user has no
 * business listing every account. The page says so rather than showing an
 * empty table, and the sidebar hides the link entirely for non-admins.
 *
 * The bearer token is read from localStorage where AuthContext put it. Anything
 * calling a guarded endpoint has to send it.
 */
import * as React from 'react';
import {
  PageHeader, Card, CardContent, DataTable, EmptyState, Badge, Button, useApi,
} from '@bloomneo/uikit';
import { Users as UsersIcon, RefreshCw, TriangleAlert, Lock } from 'lucide-react';
import { useAuth } from '../../auth/hooks';
import { config } from '../../auth/config';
import { SEO } from '@/shared/SEO';

type Row = {
  id: string;
  name?: string | null;
  email: string;
  role?: string | null;
  level?: string | null;
  isVerified?: boolean;
};

export default function UsersPage() {
  const { user } = useAuth();
  const isAdmin = (user?.role ?? '') === 'admin';

  const api = useApi({
    baseURL: import.meta.env.VITE_API_URL || 'http://localhost:3000',
    headers: {
      // AuthContext stores the JWT here on sign-in. Guarded routes need it.
      Authorization: `Bearer ${localStorage.getItem(config.auth.storage.token) ?? ''}`,
    },
  });
  const [rows, setRows] = React.useState<Row[]>([]);

  const load = React.useCallback(async () => {
    try {
      const res = await api.get<{ users?: Row[] } | Row[]>('/api/user/admin/users');
      setRows(Array.isArray(res) ? res : res?.users ?? []);
    } catch {
      /* api.error carries the message; nothing to add here. */
    }
  }, [api]);

  React.useEffect(() => { if (isAdmin) void load(); }, [isAdmin]); // eslint-disable-line react-hooks/exhaustive-deps

  const columns = [
    {
      id: 'name', header: 'Name', accessorKey: 'name' as const, sortable: true,
      cell: (_v: unknown, r: Row) => (
        <div>
          <div className="font-medium">{r.name || '—'}</div>
          <div className="text-xs text-muted-foreground">{r.email}</div>
        </div>
      ),
    },
    { id: 'role', header: 'Role', accessorKey: 'role' as const, sortable: true },
    { id: 'level', header: 'Level', accessorKey: 'level' as const, sortable: true },
    {
      id: 'isVerified', header: 'Verified', accessorKey: 'isVerified' as const,
      cell: (v: unknown) => (
        <Badge variant={v ? 'secondary' : 'outline'}>{v ? 'Yes' : 'No'}</Badge>
      ),
    },
  ];

  return (
    <div className="space-y-6">
      <SEO title="Users" description="Accounts in this workspace" />
      <PageHeader
        title="Users"
        description={`Signed in as ${user?.email ?? '—'}`}
        actions={
          isAdmin ? (
            <Button variant="outline" onClick={() => void load()} disabled={api.loading}>
              <RefreshCw className={`size-4 ${api.loading ? 'animate-spin' : ''}`} /> Refresh
            </Button>
          ) : undefined
        }
      />

      <Card>
        <CardContent>
          {!isAdmin ? (
            <EmptyState
              icon={<Lock className="size-6" />}
              title="Admins only"
              description={`This list needs an admin role. You are signed in as ${user?.role ?? '—'}.${user?.level ? '.' + user.level : ''} Try admin.system@… to see it.`}
            />
          ) : api.error ? (
            <EmptyState
              icon={<TriangleAlert className="size-6 text-destructive" />}
              title="Could not load users"
              description={String(api.error)}
              action={<Button variant="outline" onClick={() => void load()}>Try again</Button>}
            />
          ) : rows.length === 0 && !api.loading ? (
            <EmptyState
              icon={<UsersIcon className="size-6" />}
              title="No users yet"
              description="Run npm run db:seed to create the sample accounts."
            />
          ) : (
            <DataTable<Row> data={rows} columns={columns} searchable searchPlaceholder="Search users…" />
          )}
        </CardContent>
      </Card>
    </div>
  );
}
