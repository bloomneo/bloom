# Dependencies
node_modules/

# Environment files
.env
.env.*
# Allow example env files (scaffolding documentation)
!**/.env.example
!**/.env.example.template

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Claude Code configuration
.claude/

# OS files
.DS_Store
Thumbs.db

# Build files
build/
# bloom's own scripts/ (drift check, release) are tracked: CI runs them.
# A bare `scripts/` rule here once hid check-doc-drift.mjs from git, so
# every CI run failed on a file that only existed on one laptop.

# Temporary files
temp/
tmp/
*.tgz
