/**
 * Welcome routes — the server half of src/contracts/welcome.contract.ts.
 *
 * @llm-rule WHEN: Serving routes declared as contracts (defineRoute)
 * @llm-rule AVOID: Re-checking auth or re-validating input here — route() already applied the contract
 * @llm-rule NOTE: Default-export a contractRouter; createApiRouter mounts it at the contracts' own paths
 *
 * `route(contract, handler)` applies, from the contract alone and in order:
 * the auth decision, the tenant context (for non-public routes), and
 * validation of params, query and body. The handler receives the validated
 * values and RETURNS the body — 200 (201 for POST, 204 for undefined).
 * Errors thrown from it (error.badRequest(), error.notFound(), …) reach the
 * app's error handler as usual.
 *
 * No `isPublic` export is needed: each contract carries its own `auth`, and
 * both the boot check and `bloom check` read it from there.
 *
 * ── On logging inside a route ─────────────────────────────────────────────
 * server.ts records every request on completion, with the path, status and
 * duration. Don't open a handler with an "arrived" line; log decisions and
 * failures.
 */
import { route, contractRouter } from '@bloomneo/appkit/server';
import { getWelcome, getWelcomeByName } from '../../../contracts/welcome.contract.js';
import { welcomeService } from './welcome.service.js';

export default await contractRouter([
  route(getWelcome, () => welcomeService.getHello()),
  route(getWelcomeByName, ({ params }) => welcomeService.getHelloWithName(params.name)),
]);
